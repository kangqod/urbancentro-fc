{
  "name": "urbancentro-fc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "homepage": "https://kangqod.github.io/urbancentro-fc",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-build-manifest.mjs",
    "check:build": "node scripts/check-build-manifest.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "pages": "pnpm build && gh-pages -d dist",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:run"
  },
  "dependencies": {
    "antd": "^6.7.1",
    "immer": "^11.2.10",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
